{
  "expo": {
    "name": "FaceFit",
    "slug": "FaceFit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/facefit-logo.png",
    "scheme": "facefit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.asdflei.FaceFit"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/facefit-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FACE-FIT to use your camera for face-shape analysis.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FACE-FIT to select a photo for face-shape analysis."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FACE-FIT to use your location while the app is open to show nearby salons."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/facefit-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F6",
          "dark": {
            "backgroundColor": "#FFF8F6"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f53393f-a8d6-44ae-96d9-54a3c9023bb5"
      }
    }
  }
}
